{
  "projectFileVersion": 4,
  "sourceFiles": [
    "**/*.yarn"
  ],
  "excludeFiles": [
    "**/*~/*",
    "./Samples/Yarn Spinner*/*"
  ],
  "localisation": {
    "ru": {
      "assets": "."
    },
    "en": {
      "assets": "."
    }
  },
  "baseLanguage": "en",
  "compilerOptions": {
    "diagnosticsSeverity": {}
  }
}